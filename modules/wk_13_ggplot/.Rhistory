install.packages("ggpubr")
library(ggpubr)
#make 85 degree data into an item
dU_85 <- dU_GC_tidy_Stat%>%
ggplot(aes(x=Hours, y=mean, color=Strain, ymax=mean+se, ymin=mean-se)) +
geom_line(size=0.5) +
geom_point(size=1.2) +
geom_errorbar(width=0.1) +
theme_bw() +
labs(subtitle=bquote(bold("85\u00B0C")),
y = bquote(bold("OD")[600][nm]),
x = bquote(bold('Time (Hours)'))) +
scale_x_continuous(breaks=c(0, 4, 8, 12, 16, 20, 24), limits=c(0,26), expand = c(0,0)) +
scale_y_continuous(breaks=c(0, 0.3, 0.6, 0.9, 1.2), limits=c(-0.05, 1.4), expand = c(0,0)) +
scale_color_manual(values=c( "darkgrey", "red3", "yellow3", "steelblue3", "orange2", "purple3", "green2", "black"), name = "Strain", breaks=c("TS559-Parent Strain", "\u0394TK0887-Endonuclease Q", "\u0394TK1898-Endonuclease MS", "\u0394TK2143-Uracil DNA Glycosylase","\u0394TK0887/\u0394TK1898", "\u0394TK0887/\u0394TK2143", "\u0394TK1898/\u0394TK2143", "\u0394TK0887/\u0394TK1898/\u0394TK2143"))+
facet_wrap(ncol=8, ~factor(Strain, levels=c( "TS559-Parent Strain", "\u0394TK0887-Endonuclease Q", "\u0394TK1898-Endonuclease MS", "\u0394TK2143-Uracil DNA Glycosylase","\u0394TK0887/\u0394TK1898", "\u0394TK0887/\u0394TK2143", "\u0394TK1898/\u0394TK2143", "\u0394TK0887/\u0394TK1898/\u0394TK2143"))) +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank()) +
theme(plot.title = element_text(hjust = 0.5, size = 12), plot.subtitle= element_text(hjust =   0.5, size = 10)) +
theme(axis.text.x = element_text(face = 'bold', size = 8, color = "black")) +
theme(axis.text.y = element_text(face = 'bold', size = 8, color = 'black')) +
theme(axis.title.x = element_text(face = 'bold', size = 12)) +
theme(axis.title.y = element_text(face = 'bold', size = 12)) +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank()) +
theme(legend.text = element_text(face = 'bold', size = 8)) +
theme(legend.title = element_text( face = 'bold', size = 10)) +
theme(strip.text = element_text(face = "bold", size=4))+
theme(legend.position = "none")
dU_85
#95 degree data
dU_GC_tidy_95<-read.csv("Growth_Curve_dU_tidy_95.csv",fill=TRUE,header=TRUE)
dU_Neg_95 <- dU_GC_tidy_95 %>%
filter(Strain == "Blank") %>%
group_by(Hours)%>%
summarize(blank_mean = mean(OD), .groups = "drop")
dU_GC_tidy_Stat_95<- dU_GC_tidy_95 %>%
left_join(dU_Neg_95, by = "Hours") %>%
mutate(OD = OD - blank_mean) %>%
group_by(Hours, Strain) %>%
summarize(mean = mean(OD), sd = sd(OD), n = n(), se = sd / sqrt(n), .groups = "drop") %>%
filter(Strain != "Blank") %>%
mutate(Strain =
recode(Strain, "TK0887-Endonuclease Q" = "\u0394TK0887-Endonuclease Q",
"TK1898-Endonuclease MS" = "\u0394TK1898-Endonuclease MS",
"TK2143-Uracil DNA Glycosylase" = "\u0394TK2143-Uracil DNA Glycosylase",
"TK0887/TK1898" = "\u0394TK0887/\u0394TK1898",
"TK0887/TK2143" = "\u0394TK0887/\u0394TK2143",
"TK1898/TK2143" = "\u0394TK1898/\u0394TK2143",
"TK0887/TK1898/TK2143" = "\u0394TK0887/\u0394TK1898/\u0394TK2143"))
dU_95 <- dU_GC_tidy_Stat_95%>%
ggplot(aes(x=Hours, y=mean, color=Strain, ymax=mean+se, ymin=mean-se)) +
geom_line(size=0.5) +
geom_point(size=1.2) +
geom_errorbar(width=0.1) +
theme_bw() +
labs( subtitle=bquote(bold("95\u00B0C")),
y = bquote(bold("OD")[600][nm]),
x = bquote(bold('Time (Hours)'))) +
scale_x_continuous(breaks=c(0, 4, 8, 12, 16, 20, 24), limits=c(0,26), expand = c(0,0)) +
scale_y_continuous(breaks=c(0, 0.3, 0.6, 0.9, 1.2), limits=c(-0.05, 1.4), expand = c(0,0)) +
scale_color_manual(values=c( "darkgrey", "red3", "yellow3", "steelblue3", "orange2", "purple3", "green2", "black"), name = "Strain", breaks=c("TS559-Parent Strain", "\u0394TK0887-Endonuclease Q", "\u0394TK1898-Endonuclease MS", "\u0394TK2143-Uracil DNA Glycosylase","\u0394TK0887/\u0394TK1898", "\u0394TK0887/\u0394TK2143", "\u0394TK1898/\u0394TK2143", "\u0394TK0887/\u0394TK1898/\u0394TK2143"))+
facet_wrap(ncol=8, ~factor(Strain, levels=c( "TS559-Parent Strain", "\u0394TK0887-Endonuclease Q", "\u0394TK1898-Endonuclease MS", "\u0394TK2143-Uracil DNA Glycosylase","\u0394TK0887/\u0394TK1898", "\u0394TK0887/\u0394TK2143", "\u0394TK1898/\u0394TK2143", "\u0394TK0887/\u0394TK1898/\u0394TK2143"))) +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank()) +
theme(plot.title = element_text(hjust = 0.5, size = 12), plot.subtitle= element_text(hjust =   0.5, size = 10)) +
theme(axis.text.x = element_text(face = 'bold', size = 8, color = "black")) +
theme(axis.text.y = element_text(face = 'bold', size = 8, color = 'black')) +
theme(axis.title.x = element_text(face = 'bold', size = 12)) +
theme(axis.title.y = element_text(face = 'bold', size = 12)) +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank()) +
theme(legend.text = element_text(face = 'bold', size = 8)) +
theme(legend.title = element_text( face = 'bold', size = 10)) +
theme(strip.text = element_text(face = "bold", size=4))+
theme(legend.position = "none")
dU_95
#ggarange
dU_Plot <- ggarrange(dU_85, dU_95, nrow = 2, legend = "right")
dU_Plot <-annotate_figure(dU_Plot, top = text_grob("Strains lacking all dU repair components have the most severe fitness defect",
color = "black", face = "bold", size = 14))
dU_Plot
ggsave("dU_GC_Final.jpg", dU_Plot, dpi=2000, width = 10, device = 'jpeg')
knitr::opts_chunk$set(echo = F, message = F, warning = F)
