library(knitr)
library(tidyverse)
library(ggplot2)
library(readxl)
library(ggpubr)
library(ggrepel)
data()
View(quakes)
quakes %>%
ggplot(aes(x = lat, y = long, colour = mag, label = mag)) +
geom_text_repel() +
geom_point() +
theme_classic()
quakes %>%
ggplot(aes(x = lat, y = long, colour = mag)) +
geom_text(data = filter(mag, mag > 6),
aes(label = rownames(filter(mag > 6)))) +
geom_text_repel() +
geom_point() +
theme_classic()
quakes %>%
ggplot(aes(x = lat, y = long, colour = mag)) +
geom_text(data = filter(mag, mag > 6),
aes(label = rownames(filter(mag, mag > 6)))) +
geom_text_repel() +
geom_point() +
theme_classic()
quakes %>%
ggplot(aes(x = lat, y = long, colour = mag)) +
geom_text(data = filter(quakes, mag > 6),
aes(label = rownames(filter(quakes, mag > 6)))) +
geom_text_repel() +
geom_point() +
theme_classic()
