library(ggrepel)
quakes %>%
ggplot(aes(x = long, y = lat, colour = mag)) +
geom_label_repel(
data = ~ dplyr::filter(.x, mag >= 6),
aes(label = mag),
force = 5,
box.padding = 0.5,
point.padding = 0.5,
min.segment.length = 0,
max.overlaps = Inf) +
labs(x = "Longitude (degrees)", y = "Latitude (degrees)") +
geom_point() +
theme_classic()
